<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox fx:id="root" prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.controllers.ForgotPasswordController"
      style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-border-width: 1;">
    
    <!-- Header -->
    <HBox style="-fx-background-color: #3498db; -fx-background-radius: 10 10 0 0;" alignment="CENTER_LEFT">
        <padding>
            <Insets bottom="15" left="20" right="20" top="15"/>
        </padding>
        <Label text="Forgot Password" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="closeButton" text="✕" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16; -fx-cursor: hand;"
                onAction="#handleClose"/>
    </HBox>

    <!-- Content -->
    <VBox spacing="20" style="-fx-padding: 20;">
        <!-- Step 1: Email Input -->
        <VBox fx:id="emailStep" spacing="10">
            <Label text="Enter your email address" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TextField fx:id="emailField" promptText="Email" 
                      style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: #f5f7fa; -fx-padding: 10 15 10 15;"/>
            <Button fx:id="sendOtpButton" text="Send OTP" onAction="#handleSendOtp"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </VBox>

        <!-- Step 2: OTP Verification -->
        <VBox fx:id="otpStep" spacing="10" visible="false">
            <Label text="Enter the OTP sent to your email" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TextField fx:id="otpField" promptText="OTP" 
                      style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: #f5f7fa; -fx-padding: 10 15 10 15;"/>
            <Button fx:id="verifyOtpButton" text="Verify OTP" onAction="#handleVerifyOtp"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </VBox>

        <!-- Step 3: New Password -->
        <VBox fx:id="newPasswordStep" spacing="10" visible="false">
            <Label text="Enter your new password" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <PasswordField fx:id="newPasswordField" promptText="New Password" 
                          style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: #f5f7fa; -fx-padding: 10 15 10 15;"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" 
                          style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: #f5f7fa; -fx-padding: 10 15 10 15;"/>
            <Button fx:id="resetPasswordButton" text="Reset Password" onAction="#handleResetPassword"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </VBox>

        <!-- Status Label -->
        <Label fx:id="statusLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12;"/>
    </VBox>
</VBox> 