<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.controllers.SignupController"
      alignment="CENTER"
      style="-fx-background-color: #f5f7fa;"
      spacing="20"
      prefWidth="1400" prefHeight="800">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <!-- Logo/Title -->
    <VBox alignment="CENTER" spacing="10">
        <Label text="User Management" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Label text="Create a new account" style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;"/>
    </VBox>

    <!-- Signup Form -->
    <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-padding: 30;">
        <effect>
            <DropShadow radius="10" spread="0.1" color="#00000022"/>
        </effect>

        <!-- Username -->
        <VBox spacing="5">
            <Label text="Username" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TextField fx:id="usernameField" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: #f5f7fa; -fx-padding: 10 15 10 15;"/>
        </VBox>

        <!-- Email -->
        <VBox spacing="5">
            <Label text="Email" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TextField fx:id="emailField" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: #f5f7fa; -fx-padding: 10 15 10 15;"/>
        </VBox>

        <!-- Password -->
        <VBox spacing="5">
            <Label text="Password" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <PasswordField fx:id="passwordField" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: #f5f7fa; -fx-padding: 10 15 10 15;"/>
        </VBox>

        <!-- Confirm Password -->
        <VBox spacing="5">
            <Label text="Confirm Password" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <PasswordField fx:id="confirmPasswordField" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: #f5f7fa; -fx-padding: 10 15 10 15;"/>
        </VBox>

        <!-- Role -->
        <VBox spacing="5">
            <Label text="Role" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <ComboBox fx:id="roleComboBox" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: #f5f7fa; -fx-padding: 5 10 5 10;"/>
        </VBox>

        <!-- Sign Up Button -->
        <Button fx:id="signupButton" text="Sign Up" onAction="#handleSignUp" 
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 20 12 20; -fx-background-radius: 5; -fx-cursor: hand;"/>

        <!-- Login Link -->
        <HBox alignment="CENTER" spacing="5">
            <Label text="Already have an account?" style="-fx-text-fill: #7f8c8d;"/>
            <Button text="Sign In" onAction="#handleLogin" 
                    style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-padding: 0; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- Status Label -->
    <Label fx:id="statusLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12;"/>
</VBox> 