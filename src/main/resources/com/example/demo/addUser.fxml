<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controllers.AddUserController"
            style="-fx-background-color: #f5f7fa;"
            prefWidth="1400" prefHeight="800">

    
    <!-- Left Sidebar -->
    <left>
        <VBox style="-fx-background-color: #2c3e50; -fx-pref-width: 200;" spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <Label text="User Management" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
            <Separator style="-fx-background-color: #34495e;"/>
            
            <Button text="⌂ Dashboard" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15 10 15; -fx-min-width: 150; -fx-cursor: hand;"
                    onMouseEntered="#handleButtonHover"
                    onMouseExited="#handleButtonExit"/>
            
            <Button text="👥 Users" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15 10 15; -fx-min-width: 150; -fx-cursor: hand;"
                    onMouseEntered="#handleButtonHover"
                    onMouseExited="#handleButtonExit"/>
            
            <Button text="⚙ Settings" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15 10 15; -fx-min-width: 150; -fx-cursor: hand;"
                    onMouseEntered="#handleButtonHover"
                    onMouseExited="#handleButtonExit"/>

            <Button fx:id="logoutButton" text="Logout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5;"
                    onAction="#handleLogout"/>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <Label text="Admin Panel" style="-fx-text-fill: #95a5a6; -fx-font-size: 12;"/>
        </VBox>
    </left>
    
    <!-- Main Content -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="User Management" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>

            </HBox>

            <!-- Search and Filter -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search users..." prefWidth="300"
                          style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 8 12 8 12;"
                          onKeyReleased="#handleSearch"/>
                <Button fx:id="searchButton" text="🔍 Search" onAction="#handleSearch"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 8 15 8 15; -fx-background-radius: 5; -fx-cursor: hand;"
                        onMouseEntered="#handleButtonHover"
                        onMouseExited="#handleButtonExit"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="roleFilterComboBox" promptText="Filter by role"
                         style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: white; -fx-padding: 5 10 5 10;"
                         onAction="#handleRoleFilter"/>
            </HBox>

            <!-- Users Table -->
            <TableView fx:id="userTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0;">
                <effect>
                    <DropShadow radius="5" spread="0.1" color="#00000022"/>
                </effect>
                <style>
                    -fx-table-cell-border-color: transparent;
                    -fx-background-color: white;
                    -fx-text-fill: #2c3e50;
                </style>
                <columns>
                    <TableColumn text="ID" prefWidth="50.0" fx:id="idColumn" style="-fx-alignment: CENTER;">
                        <style>
                            -fx-alignment: CENTER;
                            -fx-text-fill: #2c3e50;
                            -fx-font-weight: bold;
                        </style>
                    </TableColumn>
                    <TableColumn text="Username" prefWidth="150.0" fx:id="usernameColumn">
                        <style>
                            -fx-text-fill: #2c3e50;
                        </style>
                    </TableColumn>
                    <TableColumn text="Email" prefWidth="200.0" fx:id="emailColumn">
                        <style>
                            -fx-text-fill: #2c3e50;
                        </style>
                    </TableColumn>
                    <TableColumn text="Role" prefWidth="100.0" fx:id="roleColumn" style="-fx-alignment: CENTER;">
                        <style>
                            -fx-alignment: CENTER;
                            -fx-text-fill: #2c3e50;
                            -fx-font-weight: bold;
                        </style>
                    </TableColumn>
                    <TableColumn text="Actions" prefWidth="120.0" fx:id="actionsColumn" style="-fx-alignment: CENTER;">
                        <style>
                            -fx-alignment: CENTER;
                            -fx-text-fill: #2c3e50;
                            -fx-font-weight: bold;
                        </style>
                    </TableColumn>
                </columns>
            </TableView>

            <!-- Action Buttons -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="+ Add User" fx:id="addButton" onAction="#showAddUserDialog"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 5; -fx-cursor: hand;"
                        onMouseEntered="#handleButtonHover"
                        onMouseExited="#handleButtonExit"/>
                
                <Button text="📄 Export PDF" fx:id="exportPdfButton" onAction="#handleExportPDF"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 5; -fx-cursor: hand;"
                        onMouseEntered="#handleButtonHover"
                        onMouseExited="#handleButtonExit"/>
            </HBox>

        </VBox>
    </center>
    
    <!-- Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Label fx:id="statusLabel" text="Ready" style="-fx-text-fill: #7f8c8d;"/>
        </HBox>
    </bottom>
</BorderPane>