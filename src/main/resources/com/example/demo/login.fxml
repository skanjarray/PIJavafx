<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.web.WebView?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.controllers.LoginController"
      alignment="CENTER"
      style="-fx-background-color: #f5f7fa;"
      spacing="20"
      prefWidth="1400" prefHeight="800">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <!-- Logo/Title -->
    <VBox alignment="CENTER" spacing="10">
        <Label text="User Management" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Label text="Sign in to your account" style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;"/>
    </VBox>

    <!-- Login Form -->
    <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-padding: 30;">
        <effect>
            <DropShadow radius="10" spread="0.1" color="#00000022"/>
        </effect>

        <!-- Username/Email -->
        <VBox spacing="5">
            <Label text="Username or Email" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TextField fx:id="usernameField" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: #f5f7fa; -fx-padding: 10 15 10 15;"/>
        </VBox>

        <!-- Password -->
        <VBox spacing="5">
            <Label text="Password" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <PasswordField fx:id="passwordField" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: #f5f7fa; -fx-padding: 10 15 10 15;"/>
        </VBox>

        <!-- hCaptcha -->
        <VBox spacing="5">
            <Label text="Security Check" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <WebView fx:id="captchaWebView" prefHeight="300" minHeight="300" prefWidth="400" minWidth="400" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-background-color: white;"/>
        </VBox>

        <!-- Remember Me & Forgot Password -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <CheckBox fx:id="rememberMeCheckbox" text="Remember me" style="-fx-text-fill: #7f8c8d;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Forgot Password?" onAction="#handleForgotPassword" 
                    style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-padding: 0; -fx-cursor: hand;"/>
        </HBox>

        <!-- Login Button -->
        <Button fx:id="loginButton" text="Sign In" onAction="#handleLogin" 
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 20 12 20; -fx-background-radius: 5; -fx-cursor: hand;"/>

        <!-- Sign Up Link -->
        <HBox alignment="CENTER" spacing="5">
            <Label text="Don't have an account?" style="-fx-text-fill: #7f8c8d;"/>
            <Button text="Sign Up" onAction="#handleSignUp" 
                    style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-padding: 0; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- Status Label -->
    <Label fx:id="statusLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12;"/>
</VBox> 