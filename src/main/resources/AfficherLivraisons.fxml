<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.AfficherLivraisonsController"
            stylesheets="@styles.css">

    <!-- Top Header Bar -->
    <top>
        <HBox styleClass="header-bar">
            <Label text="EcoRecycle" styleClass="app-title"/>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Système de Gestion de Recyclage" styleClass="app-subtitle"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="content-area">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Liste des Livraisons" styleClass="page-title"/>

            <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="" prefWidth="50"/>
                    <TableColumn fx:id="produitColumn" text="Produit" prefWidth="150"/>
                    <TableColumn fx:id="poidsColumn" text="Poids (kg)" prefWidth="100"/>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
                    <TableColumn fx:id="societeColumn" text="Société" prefWidth="150"/>
                    <TableColumn fx:id="qrCodeColumn" text="QR Code" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 15 0 0 0;">
                <Button text="Retour à l'accueil" onAction="#goToHome" styleClass="outline-button"/>
            </HBox>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox styleClass="footer-bar">
            <Label text="© 2024 EcoRecycle - Système de Gestion" styleClass="footer-text"/>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="v1.0" styleClass="footer-text"/>
        </HBox>
    </bottom>
</BorderPane>