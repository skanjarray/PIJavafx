<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.SupprimerSocieteRecyclageController"
            stylesheets="@styles.css">

    <!-- Top Header Bar -->
    <top>
        <HBox styleClass="header-bar">
            <Label text="EcoRecycle" styleClass="app-title"/>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Système de Gestion de Recyclage" styleClass="app-subtitle"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="content-area" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <VBox styleClass="form-container" maxWidth="500" spacing="15">
                <Label text="Supprimer Société de Recyclage" styleClass="page-title"/>

                <VBox styleClass="form-group">
                    <Label text="ID Société" styleClass="form-label"/>
                    <TextField fx:id="idField" promptText="ID de la société à supprimer" maxWidth="Infinity"/>
                </VBox>

                <Button text="Supprimer" onAction="#supprimerSociete" styleClass="primary-button" maxWidth="Infinity"/>

                <!-- Back to Home Button -->
                <Button text="Retour à l'accueil" onAction="#goToHome" styleClass="outline-button" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox styleClass="footer-bar">
            <Label text="© 2024 EcoRecycle - Système de Gestion" styleClass="footer-text"/>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="v1.0" styleClass="footer-text"/>
        </HBox>
    </bottom>
</BorderPane>