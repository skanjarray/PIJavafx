<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="900.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ChatbotController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="200.0" styleClass="header-bar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="app-title" text="EcoBot - Assistant de Recyclage">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <HBox.margin>
                        <Insets left="20.0" />
                    </HBox.margin>
                </Label>
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Button fx:id="showMapButton" mnemonicParsing="false" styleClass="primary-button" text="Afficher la carte">
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#goToHome" styleClass="outline-button" text="Retour">
                            <HBox.margin>
                                <Insets right="20.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>
    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
            <children>
                <ScrollPane fx:id="scrollPane" fitToWidth="true" prefHeight="200.0" prefWidth="200.0" styleClass="chat-area" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="chatBox" prefHeight="200.0" prefWidth="100.0" styleClass="chat-box" />
                    </content>
                </ScrollPane>
                <HBox alignment="CENTER" prefHeight="60.0" prefWidth="200.0" styleClass="input-box">
                    <children>
                        <TextField fx:id="messageField" prefHeight="40.0" promptText="Posez votre question sur le recyclage..." styleClass="message-field" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets left="10.0" right="10.0" />
                            </HBox.margin>
                        </TextField>
                        <Button fx:id="sendButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="100.0" styleClass="primary-button" text="Envoyer">
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </center>
    <left>
        <VBox styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="sidebar-title" text="EcoBot" />
                <VBox styleClass="nav-section">
                    <children>
                        <Label styleClass="nav-section-title" text="Navigation" />
                        <Button onAction="#goToHome" styleClass="nav-button" text="Accueil" />
                        <Button onAction="#goToAjouterLivraison" styleClass="nav-button" text="Ajouter Livraison" />
                        <Button onAction="#goToAfficherLivraisons" styleClass="nav-button" text="Afficher Livraisons" />
                        <Button onAction="#goToAjouterSocieteRecyclage" styleClass="nav-button" text="Ajouter Société" />
                        <Button onAction="#goToAfficherSocietesRecyclage" styleClass="nav-button" text="Afficher Sociétés" />
                        <Button onAction="#goToChatbot" styleClass="nav-button active" text="Assistant Chatbot" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>
    <bottom>
        <HBox styleClass="footer-bar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="footer-text" text="© 2024 EcoRecycle - Système de Gestion" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="footer-text" text="v1.0" />
            </children>
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>
